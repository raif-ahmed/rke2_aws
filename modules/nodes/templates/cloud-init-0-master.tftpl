#cloud-config
package_update: true
package_upgrade: true
packages:
  - open-iscsi
  - nfs-client
write_files:
- path: /etc/rancher/rke2/config.yaml
  permissions: "0600"
  content: |
    write-kubeconfig-mode: "0644"
    token: token-a1b2c3d4
    tls-san:
      - cp-int.r-1-0-0.raif-test.com
      - cp.r-1-0-0.raif-test.com
    # cni: canal
- path: /root/.bashrc
  content: |
    PATH=/var/lib/rancher/rke2/bin:$PATH
    [ -f /etc/rancher/rke2/rke2.yaml ] && export KUBECONFIG=/etc/rancher/rke2/rke2.yaml && export CRI_CONFIG_FILE=/var/lib/rancher/rke2/agent/etc/crictl.yaml
    [ -f /etc/rancher/k3s/k3s.yaml ] && export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
    alias k=kubectl
    complete -o default -F __start_kubectl k
    source <(kubectl completion bash)
- path: /home/ec2-user/.bashrc
  content: |
    PATH=/var/lib/rancher/rke2/bin:$PATH
    [ -f /etc/rancher/rke2/rke2.yaml ] && export KUBECONFIG=/etc/rancher/rke2/rke2.yaml && export CRI_CONFIG_FILE=/var/lib/rancher/rke2/agent/etc/crictl.yaml
    [ -f /etc/rancher/k3s/k3s.yaml ] && export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
    alias k=kubectl
    complete -o default -F __start_kubectl k
    source <(kubectl completion bash)
runcmd:
  - curl -sfL https://get.rke2.io | INSTALL_RKE2_VERSION="v1.36.5+rke2r1" sh -
  - systemctl enable --now rke2-server.service
  - until [ -f /etc/rancher/rke2/rke2.yaml ]; do sleep 5; done
  - mkdir -p /home/ec2-user/.kube
  - cp /etc/rancher/rke2/rke2.yaml /home/ec2-user/.kube/config
  - chown -R ec2-user:users /home/ec2-user/.kube
  - chmod 600 /home/ec2-user/.kube/config
  - ln -sf /var/lib/rancher/rke2/bin/kubectl /usr/local/bin/kubectl
  # prepare kubeconfig file that i will copy to jumpbox
  - cp /etc/rancher/rke2/rke2.yaml /tmp/rke2.yaml 
  - chown ec2-user /tmp/rke2.yaml
  - sed -i "s/127.0.0.1/cp-int.r-1-0-0.raif-test.com/g" /tmp/rke2.yaml
  # Wait for RKE2 manifests directory to exist, then write HelmChartConfig
  - until [ -d /var/lib/rancher/rke2/server/manifests ]; do sleep 5; done
  - |
    cat << 'EOF' > /var/lib/rancher/rke2/server/manifests/rke2-traefik-config.yaml
    apiVersion: helm.cattle.io/v1
    kind: HelmChartConfig
    metadata:
      name: rke2-traefik
      namespace: kube-system
    spec:
      valuesContent: |-
        additionalArguments:
          - "--serversTransport.insecureSkipVerify=true"
    EOF